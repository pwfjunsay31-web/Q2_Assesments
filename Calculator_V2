print("=== Interdimensional Calculation Device ===")

while True:
    print()
    print("Welcome to IDMC V1.9.21")
    print("1 - add")
    print("2 - subtract")
    print("3 - multiply")
    print("4 - divide")
    print("5 - quit")

    choice = input("pick one: ")

    if choice == "5":
        print("Kbai lol :)")
        break

    if choice not in ("1", "2", "3", "4"):
        print("I've never heard of")
        continue

    try:
        num1 = float(input("first number: "))
        num2 = float(input("second number: "))
    except ValueError:
        print("numbers only please")
        continue

    if choice == "1":
        answer = num1 + num2
    elif choice == "2":
        answer = num1 - num2
    elif choice == "3":
        answer = num1 * num2
    elif choice == "4":
        if num2 == 0:
            print("you can't divide by zero")
            continue
        answer = num1 / num2

    print(f"the answer will be like... {answer}!!!")
